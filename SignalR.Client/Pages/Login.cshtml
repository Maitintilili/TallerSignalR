@page
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h1 class="h4 text-center mb-4">Iniciar sesión</h1>

                <div id="alertBox" class="alert alert-danger d-none" role="alert"></div>

                <form id="loginForm" novalidate>
                    <div class="form-floating mb-3">
                        <input id="username" class="form-control" placeholder="Usuario" maxlength="20" autocomplete="username" />
                        <label for="username">Usuario</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input id="password" type="password" class="form-control" placeholder="Contraseña" maxlength="100" autocomplete="current-password" />
                        <label for="password">Contraseña</label>
                    </div>
                    <button id="submitBtn" type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>

                <p class="text-center text-muted mt-3 mb-0">
                    ¿No tienes cuenta? <a asp-page="/Register">Regístrate</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
}
