@page
@{
    ViewData["Title"] = "Chat";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Chat general</span>
                <span id="statusBadge" class="badge text-bg-secondary">Conectando...</span>
            </div>

            <div class="px-3 py-2 border-bottom small text-muted">
                En línea: <span id="onlineList">—</span>
            </div>

            <div id="messagesList" class="card-body chat-messages"></div>

            <div class="card-footer">
                <div id="errorBox" class="alert alert-danger py-1 px-2 small d-none" role="alert"></div>
                <form id="chatForm" class="input-group" autocomplete="off">
                    <input id="messageInput" class="form-control" placeholder="Escribe un mensaje..." maxlength="1000" disabled />
                    <button id="sendButton" type="submit" class="btn btn-primary" disabled>Enviar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
