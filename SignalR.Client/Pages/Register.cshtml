@page
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h1 class="h4 text-center mb-4">Crear cuenta</h1>

                <div id="alertBox" class="alert alert-danger d-none" role="alert"></div>

                <form id="registerForm" novalidate>
                    <div class="form-floating mb-1">
                        <input id="username" class="form-control" placeholder="Usuario" maxlength="20" autocomplete="username" />
                        <label for="username">Usuario</label>
                    </div>
                    <div class="form-text mb-3">3 a 20 caracteres: letras, números o guion bajo.</div>

                    <div class="form-floating mb-1">
                        <input id="password" type="password" class="form-control" placeholder="Contraseña" maxlength="100" autocomplete="new-password" />
                        <label for="password">Contraseña</label>
                    </div>
                    <div class="form-text mb-3">Mínimo 6 caracteres.</div>

                    <div class="form-floating mb-3">
                        <input id="confirm" type="password" class="form-control" placeholder="Confirmar contraseña" maxlength="100" autocomplete="new-password" />
                        <label for="confirm">Confirmar contraseña</label>
                    </div>

                    <button id="submitBtn" type="submit" class="btn btn-primary w-100">Crear cuenta</button>
                </form>

                <p class="text-center text-muted mt-3 mb-0">
                    ¿Ya tienes cuenta? <a asp-page="/Login">Inicia sesión</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/register.js" asp-append-version="true"></script>
}
